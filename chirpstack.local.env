# Variables del contenedor en ESTE PC (pruebas). Mismo formato que chirpstack.env.
#   ./despliegue/docker-run.sh ../chirpstack.local.env
# Está fuera de despliegue/ a propósito: esa carpeta es la que se entrega al servidor.

# Endpoint de server_panel en este PC (npm run dev con PORT_SERVER=3002).
API_URL=http://host.docker.internal:3002/contadores/lorawan/uplink
# Igual que CHIRPSTACK_HTTP_TOKEN del .env local de server_panel.
API_TOKEN=token-local-de-pruebas-cambiar

# Da de alta también el gateway y el contador del simulador (herramientas/simulador.js).
SIMULADOR=1
